# Clave gratuita de NVIDIA NIM: https://build.nvidia.com (perfil → API Keys)
NVIDIA_API_KEY=nvapi-...
# Opcional: modelo con visión disponible en el endpoint gratuito
NVIDIA_MODEL=google/gemma-4-31b-it
# Opcional: cambiar el endpoint (cualquier API compatible con OpenAI)
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# URL pública (para sitemap, Open Graph y canonical). Ej: https://huellasana.vercel.app
NEXT_PUBLIC_SITE_URL=
# Opcional: código de verificación de Google Search Console (meta tag)
GOOGLE_SITE_VERIFICATION=

# --- Límites de uso (opcional; con Upstash los límites se comparten entre instancias) ---
# Crea una base Redis gratis en https://console.upstash.com y copia las credenciales REST:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Ajustes (valores por defecto): 5 análisis/10 min por IP, 20/día por IP, 8000/día en total
RL_IP_PER_10MIN=5
RL_IP_PER_DAY=20
RL_GLOBAL_PER_DAY=8000

# --- Publicidad (opcional; sin esto no se muestra ningún anuncio) ---
NEXT_PUBLIC_ADSENSE_CLIENT=
# --- Contacto que aparece en pie de página y páginas legales ---
NEXT_PUBLIC_CONTACT_EMAIL=
