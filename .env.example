# Clave gratuita de NVIDIA NIM: https://build.nvidia.com (perfil → API Keys)
NVIDIA_API_KEY=nvapi-...
# Opcional: modelo con visión disponible en el endpoint gratuito
NVIDIA_MODEL=google/gemma-4-31b-it
# Opcional: cambiar el endpoint (cualquier API compatible con OpenAI)
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# URL pública (para sitemap, Open Graph y canonical). Ej: https://huellasana.vercel.app
NEXT_PUBLIC_SITE_URL=
# Opcional: código de verificación de Google Search Console (meta tag)
GOOGLE_SITE_VERIFICATION=
